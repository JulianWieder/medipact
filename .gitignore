# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Node.js & Frontend Dependencies ─────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Python & Backend Dependencies ───────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# ── Testing & Debug ─────────────────────────────────────────────────────────
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Next.js & Build Output ──────────────────────────────────────────────────
/.next/
/out/
/build

# ── Operating Systems & Misc ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
*.docx

# ── Databases ───────────────────────────────────────────────────────────────
*.db
*.db-journal
*.sqlite3
backend/*.db
backend/*.db.bak

# ── ENV Files (HINWEIS: Absolut kritisch für deine API-Keys!) ──────────────
.env
.env.local
.env.production
.env.development
*.env
backend/.env
# Erlaubt nur die Beispiel-Dateien (ohne echte Keys) im Repository
!.env.example
!backend/.env.example

# ── Vercel & Deployment ─────────────────────────────────────────────────────
.vercel

# ── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Custom Project Ignores ──────────────────────────────────────────────────
backend/migrate_now.py
/components/

# Der Cowork-Mount verbietet `rm` ("Operation not permitted"). Dateien, die aus
# der Sandbox heraus gelöscht werden sollen, landen deshalb hier und werden in
# PowerShell entfernt — sie gehören nie ins Repo.
/_to_delete/
